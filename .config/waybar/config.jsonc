{
	"reload_style_on_change": true,
    "position": "top",
    "height": 5,
    "modules-left": ["battery", "niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["pulseaudio", "wireplumber#source", "network", "bluetooth", "clock", "group/tray-drawer"],
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 150,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/tray-icon",
            "tray"
        ]
    },
    "custom/tray-icon": {
        "format": " ",
        "tooltip": false
    },
    "tray": {
    	"icon-size": 14,
        "spacing": 10,
        "show-passive-items": false
    },
    "clock": {
        "format": "{:%I:%M%p}",
        "tooltip": true,
        "tooltip-format": "{:%A, %B %d, %Y}"
    },
    "battery": {
        "states": {
            "warning": 25,
            "danger": 10,
            "critical": 5
        },
        "format": "{capacity}%",
        "format-charging": "{capacity}%",
    },
    "bluetooth": {
    	"format": "blu:on",
    	"format-disabled": "blu:off",
    	"format-connected": "blu:{num_connections}",
    	"format-no-controller": "no bluetooth cont",
    	"tooltip-format": "{device_alias}",
    	"tooltip-format-connected": "{device_enumerate}",
    	"on-click": "kitty bluetui"
    },
    "network": {
        "format-wifi": "net:{signalStrength}%",
        "format-ethernet": "eth:{ifname}",
        "format-linked": "no ip/dhcp:{ifname}",
        "format-disconnected": "disconnected",
        "tooltip-format": "{essid} via {ifname} at {ipaddr}/{cidr}",
        "on-click": "kitty impala"
    },
    "wireplumber#source": {
    	"states": {
    		"vol0": 0,
    		"normal": 1
    	},
    	"node-type": "Audio/Source",
    	"format": "mic:{volume}%",
    	"format-muted": "mic:0%",
    	"on-click": "pavucontrol -t 4"
    },
    "pulseaudio": {
    	"states": {
    		"vol0": 0,
    		"normal": 1
    	},
        "format": "vol:{volume}%",
        "format-muted": "vol:0%",
        "on-click": "pavucontrol -t 3"
    }
}
